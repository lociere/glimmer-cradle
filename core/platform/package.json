{
  "name": "@glimmer-cradle/platform",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    "./configuration": {
      "types": "./dist/configuration/index.d.ts",
      "require": "./dist/configuration/index.js",
      "default": "./dist/configuration/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./time": {
      "types": "./dist/time/clock.d.ts",
      "require": "./dist/time/clock.js",
      "default": "./dist/time/clock.js"
    },
    "./identity": {
      "types": "./dist/identity/identity.d.ts",
      "require": "./dist/identity/identity.js",
      "default": "./dist/identity/identity.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "require": "./dist/events/index.js",
      "default": "./dist/events/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "require": "./dist/observability/index.js",
      "default": "./dist/observability/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/supervisor.d.ts",
      "require": "./dist/lifecycle/supervisor.js",
      "default": "./dist/lifecycle/supervisor.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc --ignoreConfig --noEmit --target ES2022 --module Node16 --strict --skipLibCheck --types node tests/authority-fencing.test.ts tests/lifecycle-drain.test.ts tests/public-api.test.ts",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs tests/*.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.2"
  }
}
