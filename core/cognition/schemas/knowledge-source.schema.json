{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimmer-cradle.local/cognition/knowledge-source.schema.json",
  "x-glimmer-owner": "Cognition",
  "x-glimmer-contract-kind": "InternalSourceRecord",
  "x-glimmer-derived-from": "knowledge.KnowledgeSourceRecord",
  "additionalProperties": false,
