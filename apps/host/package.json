    "@glimmer-cradle/jobs": "workspace:*",
    "@glimmer-cradle/platform": "workspace:*",
    "better-sqlite3": "13.0.3",
    "@grpc/grpc-js": "1.14.0",
    "yaml": "^2.8.1",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.2",
    "vitest": "^0.34.6"
  }
