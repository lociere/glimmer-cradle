{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimmer-cradle.local/apps/cognition-worker/worker-config.schema.json",
  "title": "CognitionWorkerConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["readiness_timeout_ms", "shutdown_timeout_ms"],
