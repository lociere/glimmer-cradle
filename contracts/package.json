{
  "name": "@glimmer-cradle/contracts",
  "version": "0.1.8",
  "private": false,
  "description": "Canonical public contract artifacts for Glimmer Cradle extension tooling.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lociere/glimmer-cradle.git",
    "directory": "contracts"
  },
  "files": ["dist", "json-schema"],
  "publishConfig": { "access": "public" },
  "type": "commonjs",
  "main": "dist/glimmer/common/v1/contract_probe_pb.js",
  "exports": {
    "./json-schema/*": "./json-schema/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "baseline:refresh": "node scripts/refresh-baselines.mjs",
    "baseline:refresh:json-schema": "node scripts/refresh-baselines.mjs --json-schema-only",
    "test:gates": "node --test tests/gates/*.test.mjs",
    "lint:proto": "buf lint",
    "breaking:proto": "buf breaking --against compatibility/proto-image.binpb",
    "check:json-schema": "node scripts/check-json-schema.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "roundtrip:ts": "tsx tests/roundtrip/roundtrip.ts",
    "roundtrip:py": "node scripts/run-python-roundtrip.mjs",
    "roundtrip:cs": "node scripts/run-csharp-roundtrip.mjs",
    "roundtrip": "pnpm run roundtrip:ts && pnpm run roundtrip:py && pnpm run roundtrip:cs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:generated": "node scripts/check-generated-clean.mjs",
    "check:inventory": "node scripts/check-inventory.mjs",
    "verify": "pnpm run test:gates && pnpm run check:inventory && pnpm run lint:proto && pnpm run breaking:proto && pnpm run check:json-schema && pnpm run check:toolchain && pnpm run typecheck && pnpm run roundtrip && pnpm run check:generated"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.66.1",
    "@bufbuild/protoc-gen-es": "2.13.0",
    "@types/node": "24.13.3",
    "protoc": "33.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
