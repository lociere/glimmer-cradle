{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimmer-cradle.local/contracts/config/v1/jobs-config.schema.json",
  "title": "JobsConfig",
  "description": "持久 Jobs 的调度、重试预算和终态 body 保留政策；不拥有领域 debounce 或 authority。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scheduler": {
      "type": "object", "additionalProperties": false, "default": {},
      "properties": {
        "poll_interval_ms": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 1000 },
        "batch_size": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 8 },
        "lease_ms": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 180000 }
      }
    },
    "retry": {
      "type": "object", "additionalProperties": false, "default": {},
      "description": "max_delay_ms 必须不小于 base_delay_ms；由 Jobs 的 retryDelay 在装配时核验。",
      "properties": {
        "base_delay_ms": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 30000 },
        "max_delay_ms": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 3600000 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 3 }
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false, "default": {},
      "description": "只清理已确认投递的终态 body；unknown、待 ACK outbox、源接纳快照与 tombstone 不删除。",
      "properties": {
        "terminal_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 1209600000 }
      }
    }
  },
  "x-glimmer-owner": "Jobs owner",
  "x-glimmer-contract-kind": "Document",
  "x-glimmer-compatibility": "v2.1 new Document; already accepted source due/budget remains immutable."
}
