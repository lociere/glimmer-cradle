{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimmer-cradle.local/contracts/extension/v1/extension-host-process.schema.json",
  "title": "ExtensionHostProcessDocument",
  "description": "Extension Host 独立进程与 Kernel supervision 之间的状态阶段、IPC channel 与 fail-closed 消息文档契约。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_id", "extension_id", "stage"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "extension_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,126}[a-z0-9]$"
    },
    "process_id": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "process_alive",
        "connected",
        "handshake",
        "resource_prepared",
        "ready",
        "degraded",
        "failed",
        "stopping",
        "stopped"
      ]
    },
    "summary": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "recovery_actions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "x-glimmer-owner": "Extension Host owner",
  "x-glimmer-contract-kind": "Document",
  "x-glimmer-compatibility": "M12 Slice 6 baseline; changes require compatibility baseline refresh and Extension Host process contract review."
}
