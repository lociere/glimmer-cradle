{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glimmer-cradle.local/schemas/enums/ErrorCode.schema.json",
  "title": "ErrorCode",
  "description": "未迁移 runtime 结构使用的跨层错误码，字符串枚举且值=名。Kernel↔Cognition Service 错误已由 contracts Protobuf typed detail 拥有。归并历史：CORE_ERROR/UNKNOWN_ERROR→UNKNOWN；BRIDGE_ERROR/ADAPTER_ERROR→IPC_ERROR。",
  "type": "string",
  "enum": [
    "UNKNOWN",
    "CONFIG_ERROR",
    "LIFECYCLE_ERROR",
    "IPC_ERROR",
    "IPC_TIMEOUT",
    "PERSISTENCE_ERROR",
    "INFERENCE_ERROR",
    "CANCELLED",
    "EXTENSION_ERROR",
    "EXTENSION_VALIDATION_FAILED",
    "EXTENSION_SANDBOX_ERROR",
    "EXTENSION_PERMISSION_DENIED",
    "EXTENSION_LIFECYCLE_ERROR",
    "DOMAIN_ERROR",
    "MEMORY_NOT_FOUND",
    "PERSONA_VIOLATION",
    "EMOTION_ERROR"
  ]
}
