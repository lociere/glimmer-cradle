{
  "appId": "com.lociere.glimmercradle",
  "productName": "Glimmer Cradle",
  "directories": {
    "output": "../../dist/desktop"
  },
  "files": [
    "dist/**/*",
    "assets/icons/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../assets",
      "to": "assets",
      "filter": [
        "avatar/**/*",
        "icons/**/*",
        "sounds/**/*",
        "!**/.cache/**",
        "!**/tmp/**"
      ]
    },
    {
      "from": "../../configs",
      "to": "configs/defaults",
      "filter": [
        "**/*",
        "!secrets/**",
        "!**/secrets.yaml"
      ]
    },
    {
      "from": "../../configs/secrets/secrets.example.yaml",
      "to": "configs/defaults/secrets/secrets.example.yaml"
    },
    {
      "from": "../../build/staging/desktop/windows-x64/resources",
      "to": ".",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "executableName": "GlimmerCradle",
    "icon": "assets/icons/app-icon.ico"
  },
  "mac": {
    "icon": "assets/icons/app-icon.png"
  },
  "linux": {
    "icon": "assets/icons/app-icon.png"
  }
}
